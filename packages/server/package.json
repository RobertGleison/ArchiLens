{
  "name": "@archilens/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local ArchiLens HTTP server (Fastify). Serves /api and, in production, the built web UI.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archilens/shared": "0.1.0",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.10.0",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^18.19.0",
    "tsx": "^4.19.2"
  }
}
