{
  "name": "archilens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local single-user app that produces system-design architecture reports for GitHub repositories.",
  "engines": {
    "node": ">=18.19"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build:shared": "npm run build -w @archilens/shared",
    "dev": "npm run build:shared && concurrently -k -n server,web -c blue,green \"npm run dev -w @archilens/server\" \"npm run dev -w @archilens/web\"",
    "build": "npm run build --workspaces",
    "start": "npm start -w @archilens/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "~8.55.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "toad-cache": "3.7.0"
  }
}
